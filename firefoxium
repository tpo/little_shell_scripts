#!/bin/bash

help() {
   echo 'usage: firefoxium [URL|firefox arguments]'
   echo '       firefoxium --help'
   echo
   echo '   Run firefox in a jail with a fresh profile.'
   echo
   echo '   Depends on `firejail`.'
   echo
   exit 1
}

[ "$1" == "--help" ] && help

# -private -> empty home
# -c ...   -> do not show the "Firefox Privacy Notice" tab
#
firejail --private --apparmor --profile=/etc/firejail/firefox.profile bash \
         -c 'firefox -CreateProfile firefoxium-profile; DIR=$( find ~/.mozilla/firefox/ -name "*firefoxium-profile"); echo '"'"'user_pref("datareporting.policy.dataSubmissionPolicyBypassNotification",true);'"'"' > "$DIR/user.js"; firefox -P firefoxium-profile -no-remote '"$@"
