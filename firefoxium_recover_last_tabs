#!/bin/bash

help() {
   echo 'usage: firefoxium_recover_last_tabs'
   echo '       firefoxium_recover_last_tabs --help'
   echo
   echo '    Start firefoxium with the tab set that was rescued last'
   echo
   exit 1
}

[ "$1" == "--help" ] && help

set -e          # stop on error
set -u          # stop on undefined variable
set -o pipefail # stop part of pipeline failing

browsertabs_home="$HOME/tmp/browsertabs"
last_save_dir=$( ls -tr "$browsertabs_home" | tail -n 1 )
firefoxium --recover "$browsertabs_home/$last_save_dir/recovery.jsonlz4"

